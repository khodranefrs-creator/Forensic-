# Site URL used for canonical links, Open Graph metadata, robots.txt and sitemap.xml.
# Set this to the public production URL before deploying.
NEXT_PUBLIC_SITE_URL=https://your-domain.example

# Optional. An HTTPS endpoint that accepts a JSON POST for contact inquiries.
# When unset, the contact form validates submissions and reports that the
# message was not delivered, instead of pretending it was sent.
CONTACT_WEBHOOK_URL=
